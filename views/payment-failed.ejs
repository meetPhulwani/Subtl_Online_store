<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Payment Failed</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/orders.css">
</head>
<body class="store">

    <%- include('partials/flash') %>
    <%- include('partials/navbar', { active: 'cart' }) %>

    <div class="page">
        <div class="status-card status-card--error">
            <div class="status-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <h1>Payment Failed</h1>
            <p><%= error && error.length ? error[0] : 'Your payment could not be processed. Please try again.' %></p>
            <div class="status-actions">
                <a href="/checkout" class="btn btn-primary">Try Again</a>
                <a href="/cart" class="btn btn-outline">Back to Cart</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
