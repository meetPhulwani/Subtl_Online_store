<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Checkout</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body class="store">

    <%- include('partials/flash') %>
    <%- include('partials/navbar', { active: 'cart' }) %>

    <div class="page">
        <div class="page-header">
            <h1>Checkout</h1>
            <p>Review and confirm your order</p>
        </div>

        <div class="card checkout-card">
            <div class="card-body">
                <h3 class="section-title">Order Summary</h3>

                <% cartItems.forEach(function(item) { %>
                    <% if (item.product) { %>
                    <div class="price-row">
                        <span><%= item.product.name %> &times; <%= item.quantity %></span>
                        <span>Rs.<%= item.product.price * item.quantity %></span>
                    </div>
                    <% } %>
                <% }) %>

                <div class="price-row"><span>Subtotal</span><span>Rs.<%= subtotal %></span></div>
                <div class="price-row discount"><span>Product Discount</span><span>- Rs.<%= productDiscount %></span></div>
                <div class="price-row discount"><span>Extra Discount</span><span>- Rs.<%= extraDiscount %></span></div>
                <div class="price-row"><span>Delivery</span><span><%= deliveryFee === 0 ? 'FREE' : 'Rs.' + deliveryFee %></span></div>
                <div class="price-row"><span>Platform Fee</span><span>Rs.<%= platformFee %></span></div>
                <div class="price-row total"><span>Total</span><span>Rs.<%= total %></span></div>

                <form action="/checkout" method="POST" class="checkout-form">
                    <button type="submit" class="btn btn-primary btn-block btn-lg">
                        <i class="fa-solid fa-lock"></i> Place Order
                    </button>
                </form>

                <a href="/cart" class="back-link checkout-back">&larr; Back to bag</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

</body>
</html>
