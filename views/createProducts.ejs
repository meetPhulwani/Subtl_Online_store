<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Admin</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <%- include('partials/flash') %>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <img src="/subtl_black.svg" alt="SUBTL" class="logo">
            <nav class="admin-nav">
                <a href="/shop"><i class="fa-solid fa-store"></i> View Store</a>
                <a href="/owners/admin" class="active"><i class="fa-solid fa-plus"></i> Add Product</a>
                <a href="/owners/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </nav>
        </aside>

        <main class="admin-main">
            <div class="card card-body">
                <h2>Create New Product</h2>

                <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">

                    <div class="form-section">
                        <h3>Product Details</h3>

                        <label class="form-label">Product Image</label>
                        <input name="image" type="file" class="file-input" accept="image/*" required>

                        <div class="form-grid" style="margin-top: var(--s3);">
                            <div>
                                <label class="form-label">Name</label>
                                <input name="name" type="text" placeholder="Product name" class="input" required>
                            </div>
                            <div>
                                <label class="form-label">Price (Rs.)</label>
                                <input name="price" type="number" placeholder="999" class="input" required>
                            </div>
                            <div>
                                <label class="form-label">Discount (Rs.)</label>
                                <input name="discount" type="number" placeholder="0" class="input" value="0">
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Card Colors</h3>
                        <div class="form-grid">
                            <div>
                                <label class="form-label">Background</label>
                                <input name="bgcolor" type="text" placeholder="#f5f5f5" class="input">
                            </div>
                            <div>
                                <label class="form-label">Panel</label>
                                <input name="panelcolor" type="text" placeholder="#ffffff" class="input">
                            </div>
                            <div>
                                <label class="form-label">Text</label>
                                <input name="textcolor" type="text" placeholder="#0a0a0a" class="input">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-check"></i> Create Product
                    </button>
                </form>
            </div>
        </main>
    </div>

    <script>
        setTimeout(() => {
            document.querySelectorAll(".flash-box").forEach(box => box.remove());
        }, 4000);
    </script>

</body>
</html>
