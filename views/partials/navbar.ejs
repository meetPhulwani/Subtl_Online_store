<% var navActive = typeof active !== 'undefined' ? active : ''; %>
<div class="nav-overlay" id="navOverlay"></div>
<header class="navbar" id="navbar">
    <a href="/cart" class="navbar__cart <%= navActive === 'cart' ? 'active' : '' %>" aria-label="Shopping bag">
        <i class="fa-solid fa-bag-shopping"></i>
    </a>
    <a href="/shop" class="navbar__logo">
        <img src="/subtl_black.svg" alt="SUBTL" width="120" height="30">
    </a>
    <nav class="navbar__links" id="navLinks" aria-label="Main navigation">
        <a href="/shop" class="nav-link <%= navActive === 'shop' ? 'active' : '' %>">Shop</a>
        <a href="/cart" class="nav-link nav-link--cart <%= navActive === 'cart' ? 'active' : '' %>">Cart</a>
        <a href="/orders" class="nav-link <%= navActive === 'orders' ? 'active' : '' %>">Orders</a>
        <a href="/profile" class="nav-link <%= navActive === 'profile' ? 'active' : '' %>">Account</a>
        <a href="/users/logout" class="nav-link nav-link--muted">Sign Out</a>
    </nav>
    <button class="navbar__toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
    </button>
</header>
<script src="/js/nav.js"></script>
