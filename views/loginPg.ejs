<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Login</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body page-enter">

    <%- include('partials/flash') %>

    <div class="auth-layout">
        <!-- Visual panel -->
        <div class="auth-visual">
            <div class="auth-visual__bg"></div>
            <div class="auth-visual__line"></div>
            <div class="auth-visual__content">
                <img src="/subtl_black.svg" alt="SUBTL" class="auth-visual__logo">
                <p class="auth-visual__quote auth-visual__quote-login">Step inside.<br>Shop with intention.</p>
                <p class="auth-visual__quote auth-visual__quote-signup">Join us.<br>Curated for you.</p>
                <p class="auth-visual__sub">Est. 2026 — SUBTL</p>
            </div>
        </div>

        <!-- Form panel -->
        <div class="auth-panel-wrap">
            <div class="auth-glass">
                <div class="auth-shell" id="authShell">

                    <div class="auth-tabs">
                        <button type="button" class="auth-tab active" id="tabLogin">Sign In</button>
                        <button type="button" class="auth-tab" id="tabSignup">Create Account</button>
                    </div>

                    <h1 id="logInHeading">Welcome back</h1>
                    <p class="subtitle" id="authSubtitle">Enter your details to continue</p>

                    <form action="/users/login" id="authForm" method="POST" class="auth-form">

                        <div class="auth-field name hide">
                            <label for="fullName">Full Name</label>
                            <input type="text" class="auth-input auth-input--no-toggle name" id="fullName" name="fullName" placeholder="Your name">
                        </div>

                        <div class="auth-field">
                            <label for="mail">Email</label>
                            <input type="email" class="auth-input auth-input--no-toggle" id="mail" name="email" placeholder="you@example.com" required>
                        </div>

                        <div class="auth-field">
                            <label for="pass">Password</label>
                            <div class="auth-input-wrap">
                                <input type="password" class="auth-input" id="pass" name="password" placeholder="••••••••" required>
                                <button type="button" class="pass-toggle" id="passToggle" aria-label="Toggle password">
                                    <i class="fa-regular fa-eye" id="passIcon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="auth-extras" id="authExtras">
                            <a href="/users/forgot-password" class="forgot-link" id="forgotPass">Forgot password?</a>
                        </div>

                        <button type="submit" class="auth-submit" id="loginBtn">Sign In</button>
                    </form>

                    <!-- Hidden — JS compatibility -->
                    <button type="button" id="signUpBtn" style="display:none"></button>
                    <h2 id="greet" style="display:none"></h2>
                    <p id="sideBoxPara" style="display:none"></p>

                    <a href="/" class="auth-back">&larr; Back to entrance</a>
                </div>
            </div>
        </div>
    </div>

<script>
    const authShell = document.getElementById("authShell");
    const tabLogin = document.getElementById("tabLogin");
    const tabSignup = document.getElementById("tabSignup");
    const signUpBtn = document.getElementById("signUpBtn");
    const form = document.getElementById("authForm");
    const logInHeading = document.getElementById("logInHeading");
    const authSubtitle = document.getElementById("authSubtitle");
    const loginBtn = document.getElementById("loginBtn");
    const nameField = document.querySelector(".auth-field.name");
    const nameInput = document.getElementById("fullName");
    const authExtras = document.getElementById("authExtras");
    const pass = document.getElementById("pass");
    const passToggle = document.getElementById("passToggle");
    const passIcon = document.getElementById("passIcon");

    let isLogin = true;

    passToggle.addEventListener("click", () => {
        const show = pass.type === "password";
        pass.type = show ? "text" : "password";
        passIcon.className = show ? "fa-regular fa-eye-slash" : "fa-regular fa-eye";
    });

    function setMode(login) {
        isLogin = login;

        if (login) {
            authShell.classList.remove("signup-mode");
            form.action = "/users/login";
            tabLogin.classList.add("active");
            tabSignup.classList.remove("active");
            logInHeading.textContent = "Welcome back";
            authSubtitle.textContent = "Enter your details to continue";
            loginBtn.textContent = "Sign In";
            nameField.classList.add("hide");
            authExtras.classList.remove("hide");
            nameInput.removeAttribute("required");
        } else {
            authShell.classList.add("signup-mode");
            form.action = "/users/register";
            tabLogin.classList.remove("active");
            tabSignup.classList.add("active");
            logInHeading.textContent = "Create account";
            authSubtitle.textContent = "Start your SUBTL experience";
            loginBtn.textContent = "Create Account";
            nameField.classList.remove("hide");
            authExtras.classList.add("hide");
            nameInput.setAttribute("required", "");
        }
    }

    tabLogin.addEventListener("click", () => setMode(true));
    tabSignup.addEventListener("click", () => setMode(false));

    signUpBtn.addEventListener("click", () => setMode(!isLogin));

    setTimeout(() => {
        document.querySelectorAll(".flash-box").forEach(box => box.remove());
    }, 4000);
</script>

</body>
</html>
