<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Reset Password</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-page page-enter">

    <div class="auth-card">
        <img src="/subtl_black.svg" alt="SUBTL" class="logo">
        <h2>New password</h2>
        <p>Choose a strong password for your account.</p>

        <form action="/users/reset-password/<%= token %>" method="POST">
            <div class="auth-field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" class="auth-input auth-input--no-toggle" placeholder="••••••••" required>
            </div>
            <button type="submit" class="auth-submit">Reset Password</button>
        </form>

        <a href="/login" class="back-link">&larr; Back to sign in</a>
    </div>

</body>
</html>
