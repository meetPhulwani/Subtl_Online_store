<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Forgot Password</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-page page-enter">

    <%- include('partials/flash') %>

    <div class="auth-card">
        <img src="/subtl_black.svg" alt="SUBTL" class="logo">
        <h2>Forgot password</h2>
        <p>We'll send a reset link to your email.</p>

        <form action="/users/forgot-password" method="POST">
            <div class="auth-field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="auth-input auth-input--no-toggle" placeholder="you@example.com" required>
            </div>
            <button type="submit" class="auth-submit">Send Reset Link</button>
        </form>

        <a href="/login" class="back-link">&larr; Back to sign in</a>
    </div>

    <script src="/js/ui.js"></script>
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            var btn = document.querySelector('.auth-submit');
            btn.classList.add('is-loading');
            btn.disabled = true;
        });
    </script>
</body>
</html>
