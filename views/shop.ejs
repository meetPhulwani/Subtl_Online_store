<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Store</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/shop.css">
</head>
<body class="store">

    <%- include('partials/flash') %>
    <%- include('partials/navbar', { active: 'shop' }) %>

    <div class="page">
        <div class="shop-layout">
            <aside class="card shop-sidebar">
                <p class="shop-sidebar__title">Browse</p>
                <span class="sidebar-item">All Products</span>
                <span class="sidebar-item">New Arrivals</span>
                <span class="sidebar-item">On Sale</span>

                <p class="shop-sidebar__title">Sort by</p>
                <form method="GET" action="/shop">
                    <select name="sort" class="sort-select" onchange="this.form.submit()">
                        <option value="">Default</option>
                        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                    </select>
                </form>
            </aside>

            <main>
                <div class="shop-toolbar">
                    <h1>All Products</h1>
                    <p><%= products.length %> item<%= products.length !== 1 ? 's' : '' %></p>
                </div>

                <div class="product-grid">
                    <% products.forEach(function(product){ %>
                    <article class="product-card">
                        <div class="product-card__media">
                            <div class="product-img-wrap" style="--bg: <%= product.bgcolor || '#f5f5f5' %>;">
                                <% if (product.discount && product.discount > 0) { %>
                                    <span class="product-badge">Sale</span>
                                <% } %>
                                <div class="product-actions-top">
                                    <button type="button" class="wishlist-btn" aria-label="Add to wishlist">
                                        <i class="fa-regular fa-heart"></i>
                                    </button>
                                </div>
                                <% if (product.image && product.image.data) { %>
                                    <img src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>" alt="<%= product.name %>">
                                <% } else { %>
                                    <div class="product-img-placeholder">No Image</div>
                                <% } %>
                            </div>
                        </div>
                        <div class="product-card__body">
                            <h3 class="product-name"><%= product.name %></h3>
                            <div class="product-pricing">
                                <span class="product-price">Rs.<%= product.price %></span>
                                <% if (product.discount && product.discount > 0) { %>
                                    <span class="product-price--old">Rs.<%= product.price + product.discount %></span>
                                    <span class="product-price--save">Save Rs.<%= product.discount %></span>
                                <% } %>
                            </div>
                            <a href="/addToCart/<%= product._id %>" class="product-card__cta">Add to Bag</a>
                        </div>
                    </article>
                    <% }) %>
                </div>
            </main>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        setTimeout(function () {
            document.querySelectorAll('.flash-box').forEach(function (box) { box.remove(); });
        }, 4000);
    </script>
</body>
</html>
