<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL | Cart</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body class="store">

    <%- include('partials/flash') %>
    <%- include('partials/navbar', { active: 'cart' }) %>

    <div class="page">
        <div class="page-header">
            <h1>Shopping Bag</h1>
            <p>Review your items before checkout</p>
        </div>

        <% if (!cartItems || cartItems.length === 0) { %>
            <div class="card">
                <div class="empty-state">
                    <div class="icon">🛍</div>
                    <h3>Your bag is empty</h3>
                    <p>Discover our latest collection and find something you love.</p>
                    <a href="/shop" class="btn btn-primary">Continue Shopping</a>
                </div>
            </div>
        <% } else { %>

        <div class="cart-toolbar">
            <span class="cart-count"><%= cartItems.length %> item<%= cartItems.length !== 1 ? 's' : '' %></span>
            <button class="btn btn-danger btn-sm" onclick="updateCart(null,'clear')">Clear Bag</button>
        </div>

        <div class="cart-layout">
            <div class="card cart-items-list">
                <div class="card-body">
                    <% for (let i = 0; i < cartItems.length; i++) {
                        const item = cartItems[i];
                        const product = item.product;
                        if (!product) continue;
                    %>
                    <div class="cart-item" id="cart-item-<%= product._id %>">
                        <div class="cart-item__media">
                            <% if (product.image && product.image.data) { %>
                                <img src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>" alt="<%= product.name %>" loading="lazy" decoding="async">
                            <% } else { %>
                                <div class="img-placeholder">No Image</div>
                            <% } %>
                        </div>

                        <div class="cart-item__body">
                            <div class="cart-item__details">
                                <p class="name"><%= product.name %></p>
                                <p class="price">Rs. <%= product.price %></p>
                            </div>

                            <div class="cart-item__controls">
                                <div class="qty-box">
                                    <button type="button" id="minus-<%= product._id %>"
                                        onclick="updateCart('<%= product._id %>','decrease')"
                                        aria-label="Decrease quantity"
                                        <%= item.quantity === 1 ? 'disabled' : '' %>>−</button>
                                    <span id="qty-<%= product._id %>"><%= item.quantity %></span>
                                    <button type="button" onclick="updateCart('<%= product._id %>','increase')" aria-label="Increase quantity">+</button>
                                </div>

                                <button type="button" class="remove-btn"
                                    onclick="updateCart('<%= product._id %>', 'remove')">Remove</button>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="card summary-box">
                <h3>Order Summary</h3>
                <div class="price-row"><span>Subtotal</span><span id="subtotal">Rs. <%= subtotal %></span></div>
                <div class="price-row discount"><span>Product Discount</span><span id="productDiscount">- Rs. <%= productDiscount %></span></div>
                <div class="price-row discount"><span>Extra Discount</span><span id="extraDiscount">- Rs. <%= extraDiscount %></span></div>
                <div class="price-row"><span>Delivery</span><span id="deliveryFee"><%= deliveryFee === 0 ? 'FREE' : 'Rs. ' + deliveryFee %></span></div>
                <div class="price-row"><span>Platform Fee</span><span id="platformFee">Rs. <%= platformFee %></span></div>
                <div class="price-row total"><span>Total</span><span id="total">Rs. <%= total %></span></div>

                <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
            </div>
        </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/ui.js"></script>

<script>
async function updateCart(productId, action) {
    try {
        const res = await fetch('/cart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, action })
        });
        const data = await res.json();

        if (data.reload) { location.reload(); return; }

        if (productId && data.quantity !== undefined) {
            const qtyEl = document.getElementById(`qty-${productId}`);
            const minusBtn = document.getElementById(`minus-${productId}`);
            if (qtyEl) qtyEl.innerText = data.quantity;
            if (minusBtn) {
                minusBtn.disabled = data.quantity === 1;
                minusBtn.style.opacity = data.quantity === 1 ? "0.5" : "1";
            }
        }

        document.getElementById("subtotal").innerText = "Rs. " + (data.subtotal ?? 0);
        document.getElementById("productDiscount").innerText = "- Rs. " + (data.productDiscount ?? 0);
        document.getElementById("extraDiscount").innerText = "- Rs. " + (data.extraDiscount ?? 0);
        document.getElementById("deliveryFee").innerText = data.deliveryFee === 0 ? "FREE" : "Rs. " + data.deliveryFee;
        document.getElementById("platformFee").innerText = "Rs. " + (data.platformFee ?? 0);
        document.getElementById("total").innerText = "Rs. " + (data.total ?? 0);
    } catch (err) {
        console.error("Cart update failed", err);
    }
}
</script>

</body>
</html>
