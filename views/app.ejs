<!DOCTYPE html>
<html lang="en">
<head>
    <title>SUBTL</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body>

<section class="entrance" id="entrance">
    <div class="entrance__bg">
        <div class="entrance__gradient"></div>
        <div class="entrance__orb entrance__orb--1"></div>
        <div class="entrance__orb entrance__orb--2"></div>
        <div class="entrance__grain"></div>
        <div class="entrance__vignette"></div>
    </div>

    <div class="entrance__content">
        <img src="/subtl_black.svg" alt="SUBTL" class="entrance__logo" width="160" height="40">

        <p class="entrance__tagline">Quietly Swanky</p>

        <div class="entrance__cta">
            <a href="/login" class="entrance__btn" id="enterBtn">
                <span>Enter Store</span>
            </a>
        </div>
    </div>
</section>

<script>
(function () {
    var btn = document.getElementById('enterBtn');
    var entrance = document.getElementById('entrance');

    btn.addEventListener('click', function (e) {
        e.preventDefault();
        entrance.classList.add('exiting');
        setTimeout(function () {
            window.location.href = '/login';
        }, 650);
    });
})();
</script>

</body>
</html>
